{
  "name": "voxfox",
  "version": "0.1.0",
  "private": true,
  "description": "Listen to any webpage with a single click. Natural on-device voices powered by Kokoro.",
  "type": "module",
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "defuddle": "0.19.6",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/icons.mjs",
    "zip": "npm run build && cd dist && zip -qr ../voxfox.zip .",
    "test": "node --test --experimental-test-module-mocks test/*.test.mjs"
  }
}
